---
import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Orçamentos que não ficam no esquecimento</title>

        <meta
            name="description"
            content="Crie orçamentos profissionais, envie pelo WhatsApp e acompanhe quando o cliente visualizar ou aceitar."
        />
    </head>

    <body>
        <main>
            <div class="mx-auto max-w-7xl px-5 py-20">
                <p class="text-sm font-semibold text-[var(--color-accent)]">
                    Acesso antecipado
                </p>

                <h1 class="mt-4 max-w-3xl text-5xl font-bold tracking-tight">
                    Pare de perder clientes depois de enviar o orçamento.
                </h1>
            </div>
        </main>
    </body>
</html>
