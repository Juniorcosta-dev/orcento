---
import "../../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>
            Guias sobre orçamento, follow-up e vendas de serviços | Orcento
        </title>

        <meta
            name="description"
            content="Guias práticos sobre orçamento, follow-up pelo WhatsApp, organização de propostas e vendas de serviços para profissionais autônomos."
        />

        <meta name="robots" content="index,follow" />

        <link rel="canonical" href="https://orcento.vercel.app/guias" />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:site_name" content="Orcento" />

        <meta property="og:url" content="https://orcento.vercel.app/guias" />

        <meta
            property="og:title"
            content="Guias sobre orçamento, follow-up e vendas de serviços"
        />

        <meta
            property="og:description"
            content="Conteúdos práticos para quem envia orçamentos pelo WhatsApp e quer acompanhar melhor cada oportunidade."
        />

        <meta
            property="og:image"
            content="https://orcento.vercel.app/og-image.png"
        />

        <meta name="twitter:card" content="summary_large_image" />

        <link rel="icon" type="image/png" href="/favicon.png" />

        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-72B6FEKD9G"
        ></script>

        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                window.dataLayer.push(arguments);
            }

            gtag("js", new Date());
            gtag("config", "G-72B6FEKD9G");
        </script>
    </head>

    <body class="bg-white text-text">
        <header class="border-b border-border bg-white">
            <div
                class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8"
            >
                <a href="/" class="text-lg font-bold tracking-tight text-brand">
                    Orcento
                </a>

                <a
                    href="/#interesse"
                    class="rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark"
                >
                    Quero testar
                </a>
            </div>
        </header>

        <main>
            <!-- Hero -->
            <section class="border-b border-border bg-surface">
                <div
                    class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8"
                >
                    <div class="max-w-3xl">
                        <p class="text-sm font-semibold text-brand">
                            Conteúdo para profissionais de serviços
                        </p>

                        <h1
                            class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl"
                        >
                            Guias para enviar melhores orçamentos e acompanhar
                            cada oportunidade.
                        </h1>

                        <p class="mt-5 text-lg leading-8 text-muted">
                            Conteúdos práticos sobre follow-up, WhatsApp,
                            organização de propostas e vendas de serviços.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Guias -->
            <section class="px-5 py-12 sm:px-6 sm:py-16 lg:px-8">
                <div class="mx-auto max-w-6xl">
                    <div class="mb-8">
                        <p class="text-sm font-semibold text-brand">
                            Guias disponíveis
                        </p>

                        <h2
                            class="mt-2 text-2xl font-bold tracking-tight text-text sm:text-3xl"
                        >
                            Comece por uma dúvida que você já enfrenta no dia a
                            dia.
                        </h2>
                    </div>

                    <div class="grid gap-5 md:grid-cols-2">
                        <article
                            class="flex flex-col rounded-3xl border border-border bg-white p-6 transition hover:border-brand"
                        >
                            <div>
                                <span
                                    class="inline-flex rounded-full bg-surface px-3 py-1 text-xs font-semibold text-brand"
                                >
                                    Follow-up
                                </span>

                                <h3 class="mt-4 text-xl font-bold text-text">
                                    Cliente visualizou o orçamento e não
                                    respondeu: o que fazer?
                                </h3>

                                <p class="mt-3 text-sm leading-6 text-muted">
                                    Veja quanto tempo esperar, como retomar a
                                    conversa e quais mensagens usar quando o
                                    cliente recebe a proposta e fica em
                                    silêncio.
                                </p>
                            </div>

                            <a
                                href="/guias/cliente-nao-respondeu-orcamento"
                                class="mt-6 inline-flex font-semibold text-brand transition hover:text-brand-dark"
                            >
                                Ler guia →
                            </a>
                        </article>

                        <article
                            class="flex flex-col rounded-3xl border border-border bg-white p-6 transition hover:border-brand"
                        >
                            <div>
                                <span
                                    class="inline-flex rounded-full bg-surface px-3 py-1 text-xs font-semibold text-brand"
                                >
                                    WhatsApp
                                </span>

                                <h3 class="mt-4 text-xl font-bold text-text">
                                    Como fazer follow-up de orçamento pelo
                                    WhatsApp
                                </h3>

                                <p class="mt-3 text-sm leading-6 text-muted">
                                    Aprenda quando retomar o contato, quantas
                                    vezes tentar e como escrever mensagens sem
                                    parecer insistente.
                                </p>
                            </div>

                            <a
                                href="/guias/follow-up-de-orcamento"
                                class="mt-6 inline-flex font-semibold text-brand transition hover:text-brand-dark"
                            >
                                Ler guia →
                            </a>
                        </article>
                    </div>

                    <!-- Próximos conteúdos -->
                    <div
                        class="mt-10 rounded-3xl border border-border bg-surface p-6 sm:p-8"
                    >
                        <p class="text-sm font-semibold text-brand">
                            Próximos guias
                        </p>

                        <h2 class="mt-2 text-2xl font-bold text-text">
                            Estamos preparando mais conteúdos práticos.
                        </h2>

                        <p
                            class="mt-4 max-w-3xl text-base leading-7 text-muted"
                        >
                            Os próximos temas vão abordar criação de orçamento,
                            organização de propostas e situações específicas de
                            profissionais que vendem serviços pelo WhatsApp.
                        </p>
                    </div>

                    <!-- CTA -->
                    <div
                        class="mt-10 rounded-3xl border border-border bg-white p-6 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-8"
                    >
                        <div>
                            <p class="text-sm font-semibold text-brand">
                                Orcento
                            </p>

                            <h2
                                class="mt-2 text-2xl font-bold tracking-tight text-text"
                            >
                                Quer acompanhar seus orçamentos de um jeito mais
                                simples?
                            </h2>

                            <p
                                class="mt-3 max-w-2xl text-base leading-7 text-muted"
                            >
                                O Orcento está sendo validado para ajudar
                                profissionais a acompanhar propostas enviadas
                                pelo WhatsApp, identificar quem precisa de
                                follow-up e saber quando o cliente aceita.
                            </p>
                        </div>

                        <a
                            href="/#interesse"
                            data-track="guides_cta_clicked"
                            class="mt-6 inline-flex shrink-0 items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark sm:mt-0"
                        >
                            Quero participar do teste →
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <footer class="border-t border-border bg-white">
            <div
                class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm text-muted sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"
            >
                <p>© 2026 Orcento.</p>

                <a href="/" class="font-medium transition hover:text-brand">
                    Voltar para a página inicial
                </a>
            </div>
        </footer>

        <script>
            function trackEvent(eventName: string) {
                const gtag = (
                    window as Window & {
                        gtag?: (
                            command: string,
                            eventName: string,
                            params?: Record<string, unknown>,
                        ) => void;
                    }
                ).gtag;

                if (typeof gtag === "function") {
                    gtag("event", eventName);
                }

                console.log("[analytics]", eventName);
            }

            document.querySelectorAll("[data-track]").forEach((element) => {
                element.addEventListener("click", () => {
                    const eventName = element.getAttribute("data-track");

                    if (eventName) {
                        trackEvent(eventName);
                    }
                });
            });
        </script>
    </body>
</html>
