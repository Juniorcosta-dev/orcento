---
import "../../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>
            Como fazer orçamento pelo WhatsApp: passo a passo e mensagem pronta
        </title>

        <meta
            name="description"
            content="Aprenda como fazer um orçamento profissional pelo WhatsApp, o que incluir na proposta, como enviar e qual mensagem usar com o cliente."
        />

        <meta name="robots" content="index,follow" />

        <link
            rel="canonical"
            href="https://orcento.vercel.app/guias/como-fazer-orcamento-pelo-whatsapp"
        />

        <meta property="og:type" content="article" />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:site_name" content="Orcento" />

        <meta
            property="og:url"
            content="https://orcento.vercel.app/guias/como-fazer-orcamento-pelo-whatsapp"
        />

        <meta
            property="og:title"
            content="Como fazer orçamento pelo WhatsApp: passo a passo"
        />

        <meta
            property="og:description"
            content="Veja como montar uma proposta profissional, enviar pelo WhatsApp e acompanhar o cliente depois do envio."
        />

        <meta
            property="og:image"
            content="https://orcento.vercel.app/og-image.png"
        />

        <meta name="twitter:card" content="summary_large_image" />

        <link rel="icon" type="image/png" href="/favicon.png" />

        <!-- Article -->
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Article",
                headline:
                    "Como fazer orçamento pelo WhatsApp: passo a passo e mensagem pronta",
                description:
                    "Aprenda como fazer um orçamento profissional pelo WhatsApp, o que incluir na proposta, como enviar e qual mensagem usar com o cliente.",
                mainEntityOfPage: {
                    "@type": "WebPage",
                    "@id": "https://orcento.vercel.app/guias/como-fazer-orcamento-pelo-whatsapp",
                },
                url: "https://orcento.vercel.app/guias/como-fazer-orcamento-pelo-whatsapp",
                image: ["https://orcento.vercel.app/og-image.png"],
                author: {
                    "@type": "Organization",
                    name: "Orcento",
                },
                publisher: {
                    "@type": "Organization",
                    name: "Orcento",
                },
            })}
        />

        <!-- Breadcrumb -->
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                itemListElement: [
                    {
                        "@type": "ListItem",
                        position: 1,
                        name: "Início",
                        item: "https://orcento.vercel.app/",
                    },
                    {
                        "@type": "ListItem",
                        position: 2,
                        name: "Guias",
                        item: "https://orcento.vercel.app/guias",
                    },
                    {
                        "@type": "ListItem",
                        position: 3,
                        name: "Como fazer orçamento pelo WhatsApp",
                        item: "https://orcento.vercel.app/guias/como-fazer-orcamento-pelo-whatsapp",
                    },
                ],
            })}
        />

        <!-- GA4 -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-72B6FEKD9G"
        ></script>

        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                window.dataLayer.push(arguments);
            }

            gtag("js", new Date());
            gtag("config", "G-72B6FEKD9G");
        </script>
    </head>

    <body class="bg-white text-text">
        <header class="border-b border-border bg-white">
            <div
                class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8"
            >
                <a href="/" class="text-lg font-bold tracking-tight text-brand">
                    Orcento
                </a>

                <a
                    href="/#interesse"
                    class="rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark"
                >
                    Quero testar
                </a>
            </div>
        </header>

        <main>
            <article>
                <!-- Hero -->
                <section class="border-b border-border bg-surface">
                    <div
                        class="mx-auto max-w-4xl px-5 py-14 sm:px-6 sm:py-18 lg:px-8"
                    >
                        <p class="text-sm font-semibold text-brand">
                            Guia prático
                        </p>

                        <h1
                            class="mt-3 text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl"
                        >
                            Como fazer um orçamento profissional pelo WhatsApp
                        </h1>

                        <p class="mt-5 text-lg leading-8 text-muted">
                            Veja o que colocar no orçamento, como apresentar o
                            valor, qual mensagem enviar ao cliente e como
                            acompanhar a proposta depois do envio.
                        </p>

                        <div
                            class="mt-6 flex flex-wrap gap-3 text-sm text-muted"
                        >
                            <span>Orçamento pelo WhatsApp</span>
                            <span aria-hidden="true">•</span>
                            <span>Propostas</span>
                            <span aria-hidden="true">•</span>
                            <span>Prestadores de serviços</span>
                        </div>
                    </div>
                </section>

                <!-- Conteúdo -->
                <section class="px-5 py-12 sm:px-6 sm:py-16 lg:px-8">
                    <div class="mx-auto max-w-3xl">
                        <div class="space-y-12">
                            <section>
                                <p
                                    class="text-base leading-8 text-muted sm:text-lg"
                                >
                                    Para muitos profissionais de serviços, o
                                    WhatsApp é o principal canal de contato com
                                    o cliente. É por ele que chegam os pedidos,
                                    as dúvidas, as fotos do serviço e, muitas
                                    vezes, também o orçamento.
                                </p>

                                <p
                                    class="mt-5 text-base leading-8 text-muted sm:text-lg"
                                >
                                    O problema é que enviar apenas um valor
                                    solto na conversa pode passar pouca clareza
                                    e dificultar a decisão do cliente.
                                </p>

                                <p
                                    class="mt-5 text-base leading-8 text-muted sm:text-lg"
                                >
                                    Um orçamento profissional pelo WhatsApp deve
                                    deixar claro o que será feito, quanto custa,
                                    quais são as condições e qual é o próximo
                                    passo.
                                </p>
                            </section>

                            <section>
                                <h2
                                    class="text-2xl font-bold tracking-tight text-text sm:text-3xl"
                                >
                                    O que colocar em um orçamento pelo WhatsApp?
                                </h2>

                                <p class="mt-4 text-base leading-8 text-muted">
                                    Mesmo que o orçamento seja simples, algumas
                                    informações ajudam o cliente a entender
                                    exatamente o que está contratando.
                                </p>

                                <ul
                                    class="mt-5 space-y-3 text-base leading-7 text-muted"
                                >
                                    <li>• Nome do cliente.</li>
                                    <li>• Descrição do serviço.</li>
                                    <li>• Materiais ou itens incluídos.</li>
                                    <li>• Valor total.</li>
                                    <li>• Forma de pagamento.</li>
                                    <li>• Prazo ou previsão para execução.</li>
                                    <li>• Validade do orçamento.</li>
                                    <li>
                                        • Informações importantes sobre o
                                        serviço.
                                    </li>
                                </ul>

                                <div
                                    class="mt-6 rounded-2xl border border-border bg-surface p-5"
                                >
                                    <p class="font-semibold text-text">
                                        Evite mandar apenas o preço
                                    </p>

                                    <p
                                        class="mt-2 text-sm leading-6 text-muted"
                                    >
                                        Um valor sem contexto facilita a
                                        comparação apenas pelo preço. Quando
                                        você descreve claramente o serviço, o
                                        cliente consegue entender melhor o que
                                        está incluído na proposta.
                                    </p>
                                </div>
                            </section>

                            <section>
                                <h2
                                    class="text-2xl font-bold tracking-tight text-text sm:text-3xl"
                                >
                                    Como montar um orçamento profissional
                                </h2>

                                <p class="mt-4 text-base leading-8 text-muted">
                                    O orçamento não precisa parecer um documento
                                    complicado. O mais importante é que seja
                                    fácil de ler e transmita segurança.
                                </p>

                                <div class="mt-6 space-y-5">
                                    <div
                                        class="rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            1. Identifique o cliente
                                        </p>

                                        <p
                                            class="mt-3 text-base leading-7 text-muted"
                                        >
                                            Use o nome do cliente e, quando
                                            fizer sentido, o endereço ou local
                                            onde o serviço será realizado.
                                        </p>
                                    </div>

                                    <div
                                        class="rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            2. Explique o serviço
                                        </p>

                                        <p
                                            class="mt-3 text-base leading-7 text-muted"
                                        >
                                            Descreva de forma objetiva o que
                                            será realizado. Evite termos muito
                                            genéricos como apenas “manutenção”
                                            ou “instalação”.
                                        </p>
                                    </div>

                                    <div
                                        class="rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            3. Mostre o valor com clareza
                                        </p>

                                        <p
                                            class="mt-3 text-base leading-7 text-muted"
                                        >
                                            Informe o valor total e explique
                                            condições de pagamento quando houver
                                            parcelamento, entrada ou outras
                                            condições.
                                        </p>
                                    </div>

                                    <div
                                        class="rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            4. Defina prazo e validade
                                        </p>

                                        <p
                                            class="mt-3 text-base leading-7 text-muted"
                                        >
                                            Informe quando o serviço pode ser
                                            realizado e por quanto tempo aquela
                                            proposta permanece válida.
                                        </p>
                                    </div>
                                </div>
                            </section>

                            <section>
                                <h2
                                    class="text-2xl font-bold tracking-tight text-text sm:text-3xl"
                                >
                                    É melhor enviar o orçamento no WhatsApp ou
                                    em PDF?
                                </h2>

                                <p class="mt-4 text-base leading-8 text-muted">
                                    Os dois formatos podem funcionar.
                                </p>

                                <p class="mt-5 text-base leading-8 text-muted">
                                    Para serviços muito simples, a própria
                                    mensagem pode ser suficiente. Quando existem
                                    vários itens, condições ou valores, um
                                    orçamento em PDF ou uma proposta organizada
                                    costuma ser mais fácil de consultar depois.
                                </p>

                                <p class="mt-5 text-base leading-8 text-muted">
                                    Uma boa prática é enviar o documento junto
                                    com uma mensagem curta explicando o que está
                                    sendo enviado e deixando espaço para
                                    dúvidas.
                                </p>
                            </section>

                            <section>
                                <h2
                                    class="text-2xl font-bold tracking-tight text-text sm:text-3xl"
                                >
                                    Mensagem para enviar orçamento pelo WhatsApp
                                </h2>

                                <p class="mt-4 text-base leading-8 text-muted">
                                    Evite enviar apenas o arquivo sem contexto.
                                    Uma mensagem curta deixa o contato mais
                                    profissional e facilita a resposta.
                                </p>

                                <div
                                    class="mt-6 rounded-2xl border border-border bg-surface p-5"
                                >
                                    <p class="text-sm font-semibold text-brand">
                                        Exemplo de mensagem
                                    </p>

                                    <p
                                        class="mt-4 text-base leading-7 text-text"
                                    >
                                        Olá, Carlos! Preparei o orçamento do
                                        serviço que conversamos. Estou te
                                        enviando a proposta com os detalhes,
                                        valor e condições.
                                    </p>

                                    <p
                                        class="mt-3 text-base leading-7 text-text"
                                    >
                                        Se ficar alguma dúvida, pode me chamar
                                        por aqui que eu te explico.
                                    </p>
                                </div>
                            </section>

                            <section>
                                <h2
                                    class="text-2xl font-bold tracking-tight text-text sm:text-3xl"
                                >
                                    O que fazer depois de enviar o orçamento?
                                </h2>

                                <p class="mt-4 text-base leading-8 text-muted">
                                    O envio não deveria ser o fim do processo.
                                </p>

                                <p class="mt-5 text-base leading-8 text-muted">
                                    Se o cliente não responder, é importante
                                    saber quando retomar a conversa. Muitos
                                    profissionais enviam propostas e depois
                                    dependem apenas da memória ou da própria
                                    conversa no WhatsApp para lembrar quem
                                    precisa de retorno.
                                </p>

                                <p class="mt-5 text-base leading-8 text-muted">
                                    Quanto maior o número de orçamentos
                                    enviados, mais difícil fica acompanhar quem
                                    respondeu, quem ainda está analisando e quem
                                    precisa de follow-up.
                                </p>
                            </section>

                            <!-- Links internos -->
                            <section>
                                <h2
                                    class="text-2xl font-bold tracking-tight text-text sm:text-3xl"
                                >
                                    Depois do envio, acompanhe a resposta do
                                    cliente
                                </h2>

                                <div class="mt-6 grid gap-5">
                                    <div
                                        class="rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            Leia também
                                        </p>

                                        <h3
                                            class="mt-2 text-xl font-bold text-text"
                                        >
                                            Como fazer follow-up de orçamento
                                            pelo WhatsApp
                                        </h3>

                                        <p
                                            class="mt-2 text-sm leading-6 text-muted"
                                        >
                                            Veja quando retomar o contato,
                                            quantas vezes tentar e como escrever
                                            a mensagem sem parecer insistente.
                                        </p>

                                        <a
                                            href="/guias/follow-up-de-orcamento"
                                            class="mt-4 inline-flex font-semibold text-brand transition hover:text-brand-dark"
                                        >
                                            Ver guia de follow-up →
                                        </a>
                                    </div>

                                    <div
                                        class="rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            Outra situação comum
                                        </p>

                                        <h3
                                            class="mt-2 text-xl font-bold text-text"
                                        >
                                            Cliente visualizou o orçamento e não
                                            respondeu
                                        </h3>

                                        <p
                                            class="mt-2 text-sm leading-6 text-muted"
                                        >
                                            Entenda o que pode estar acontecendo
                                            e como decidir se é hora de retomar
                                            a conversa.
                                        </p>

                                        <a
                                            href="/guias/cliente-nao-respondeu-orcamento"
                                            class="mt-4 inline-flex font-semibold text-brand transition hover:text-brand-dark"
                                        >
                                            Ver guia completo →
                                        </a>
                                    </div>
                                </div>
                            </section>

                            <!-- CTA -->
                            <section
                                class="rounded-3xl border border-border bg-surface p-6 sm:p-8"
                            >
                                <p class="text-sm font-semibold text-brand">
                                    Orcento
                                </p>

                                <h2
                                    class="mt-2 text-2xl font-bold tracking-tight text-text"
                                >
                                    Envie o orçamento e acompanhe o que acontece
                                    depois.
                                </h2>

                                <p class="mt-4 text-base leading-7 text-muted">
                                    O Orcento está sendo validado para ajudar
                                    profissionais a criar propostas, enviar pelo
                                    WhatsApp e identificar quem visualizou, quem
                                    precisa de follow-up e quando o cliente
                                    aceita.
                                </p>

                                <a
                                    href="/#interesse"
                                    data-track="guide_cta_clicked"
                                    class="mt-6 inline-flex items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                >
                                    Conhecer o Orcento →
                                </a>
                            </section>
                        </div>
                    </div>
                </section>
            </article>
        </main>

        <footer class="border-t border-border bg-white">
            <div
                class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm text-muted sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"
            >
                <p>© 2026 Orcento.</p>

                <div class="flex flex-wrap gap-4">
                    <a
                        href="/guias"
                        class="font-medium transition hover:text-brand"
                    >
                        Ver todos os guias
                    </a>

                    <a href="/" class="font-medium transition hover:text-brand">
                        Página inicial
                    </a>
                </div>
            </div>
        </footer>

        <script>
            function trackEvent(eventName: string) {
                const gtag = (
                    window as Window & {
                        gtag?: (
                            command: string,
                            eventName: string,
                            params?: Record<string, unknown>,
                        ) => void;
                    }
                ).gtag;

                if (typeof gtag === "function") {
                    gtag("event", eventName);
                }

                console.log("[analytics]", eventName);
            }

            document.querySelectorAll("[data-track]").forEach((element) => {
                element.addEventListener("click", () => {
                    const eventName = element.getAttribute("data-track");

                    if (eventName) {
                        trackEvent(eventName);
                    }
                });
            });
        </script>
    </body>
</html>
