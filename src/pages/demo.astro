---
import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Demo visual | Orcento</title>

        <meta
            name="description"
            content="Veja como o Orcento ajuda profissionais a acompanhar orçamentos enviados pelo WhatsApp."
        />

        <meta name="robots" content="noindex,nofollow" />

        <link rel="icon" type="image/png" href="/favicon.png" />

        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-72B6FEKD9G"
        ></script>
    </head>

    <body class="bg-surface text-text">
        <main class="min-h-screen">
            <!-- Header -->
            <header class="border-b border-border bg-white">
                <div
                    class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-6 lg:px-8"
                >
                    <div class="flex items-center gap-4">
                        <a
                            href="/"
                            class="text-sm font-medium text-muted transition hover:text-brand"
                        >
                            ← Voltar
                        </a>

                        <div class="hidden h-5 w-px bg-border sm:block"></div>

                        <a
                            href="/"
                            class="text-lg font-bold tracking-tight text-brand"
                        >
                            Orcento
                        </a>

                        <span
                            class="hidden rounded-full bg-surface px-3 py-1 text-xs font-semibold text-muted sm:inline-flex"
                        >
                            Demo visual
                        </span>
                    </div>

                    <a
                        href="/#interesse"
                        class="hidden rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark sm:inline-flex"
                    >
                        Quero testar
                    </a>
                </div>
            </header>

            <!-- Intro -->
            <section class="px-5 pb-8 pt-10 sm:px-6 sm:pt-14 lg:px-8">
                <div class="mx-auto max-w-7xl">
                    <div class="max-w-3xl">
                        <div
                            class="mb-5 inline-flex items-center gap-2 rounded-full border border-border bg-white px-3 py-1.5 text-xs font-semibold text-muted"
                        >
                            <span class="h-2 w-2 rounded-full bg-accent"></span>
                            <span id="demo-step-label">Etapa 1 de 4</span>
                        </div>

                        <h1
                            class="max-w-3xl text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl"
                        >
                            Saiba quais orçamentos precisam da sua atenção.
                        </h1>

                        <p
                            class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg"
                        >
                            O Orcento organiza os orçamentos enviados e mostra
                            rapidamente quem visualizou, quem aceitou e quem
                            ainda precisa de follow-up.
                        </p>

                        <p class="mt-3 text-sm text-muted">
                            Esta é uma demonstração visual. Nenhuma mensagem
                            real será enviada.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Demo -->
            <section class="px-5 pb-16 sm:px-6 lg:px-8">
                <div class="mx-auto max-w-7xl">
                    <div id="demo-step-1">
                        <div
                            class="overflow-hidden rounded-3xl border border-border bg-white shadow-[0_24px_80px_rgba(23,35,34,0.08)]"
                        >
                            <!-- App topbar -->
                            <div
                                class="flex flex-col gap-4 border-b border-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7"
                            >
                                <div>
                                    <p class="text-sm font-medium text-muted">
                                        Visão geral
                                    </p>
                                    <h2
                                        class="mt-1 text-xl font-bold text-text"
                                    >
                                        Bom dia, Carlos
                                    </h2>
                                </div>

                                <div class="flex items-center gap-3">
                                    <span
                                        class="rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold text-muted"
                                    >
                                        Setembro
                                    </span>

                                    <span
                                        class="rounded-full bg-brand px-3 py-1.5 text-xs font-semibold text-white"
                                        aria-hidden="true"
                                    >
                                        + Novo orçamento
                                    </span>
                                </div>
                            </div>

                            <div class="p-5 sm:p-7">
                                <!-- Metrics -->
                                <div
                                    class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"
                                >
                                    <article
                                        class="rounded-2xl border border-border bg-white p-4"
                                    >
                                        <p
                                            class="text-sm font-medium text-muted"
                                        >
                                            Em acompanhamento
                                        </p>

                                        <div
                                            class="mt-3 flex items-end justify-between gap-3"
                                        >
                                            <strong
                                                class="text-3xl font-bold text-text"
                                                >8</strong
                                            >

                                            <span
                                                class="rounded-full bg-surface px-2.5 py-1 text-xs font-semibold text-muted"
                                            >
                                                ativos
                                            </span>
                                        </div>
                                    </article>

                                    <article
                                        class="rounded-2xl border border-border bg-white p-4"
                                    >
                                        <p
                                            class="text-sm font-medium text-muted"
                                        >
                                            Visualizados
                                        </p>

                                        <div
                                            class="mt-3 flex items-end justify-between gap-3"
                                        >
                                            <strong
                                                class="text-3xl font-bold text-text"
                                                >3</strong
                                            >

                                            <span
                                                class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700"
                                            >
                                                atenção
                                            </span>
                                        </div>
                                    </article>

                                    <article
                                        class="rounded-2xl border border-border bg-white p-4"
                                    >
                                        <p
                                            class="text-sm font-medium text-muted"
                                        >
                                            Aceitos
                                        </p>

                                        <div
                                            class="mt-3 flex items-end justify-between gap-3"
                                        >
                                            <strong
                                                class="text-3xl font-bold text-text"
                                                >2</strong
                                            >

                                            <span
                                                class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"
                                            >
                                                fechados
                                            </span>
                                        </div>
                                    </article>

                                    <article
                                        class="rounded-2xl border border-border bg-white p-4"
                                    >
                                        <p
                                            class="text-sm font-medium text-muted"
                                        >
                                            Aguardando resposta
                                        </p>

                                        <div
                                            class="mt-3 flex items-end justify-between gap-3"
                                        >
                                            <strong
                                                class="text-3xl font-bold text-text"
                                                >2</strong
                                            >

                                            <span
                                                class="rounded-full bg-surface px-2.5 py-1 text-xs font-semibold text-muted"
                                            >
                                                pendentes
                                            </span>
                                        </div>
                                    </article>
                                </div>

                                <!-- Quotes -->
                                <div class="mt-8">
                                    <div
                                        class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between"
                                    >
                                        <div>
                                            <h3
                                                class="text-lg font-bold text-text"
                                            >
                                                Orçamentos recentes
                                            </h3>

                                            <p class="mt-1 text-sm text-muted">
                                                Veja rapidamente quem precisa da
                                                sua atenção.
                                            </p>
                                        </div>

                                        <span
                                            class="text-sm font-semibold text-brand"
                                            aria-hidden="true"
                                        >
                                            Ver todos os orçamentos
                                        </span>
                                    </div>

                                    <div class="space-y-3">
                                        <!-- João -->
                                        <article
                                            class="rounded-2xl border border-border bg-white p-4 transition sm:p-5"
                                        >
                                            <div
                                                class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
                                            >
                                                <div class="min-w-0">
                                                    <div
                                                        class="flex flex-wrap items-center gap-2"
                                                    >
                                                        <h4
                                                            class="font-bold text-text"
                                                        >
                                                            João Silva
                                                        </h4>

                                                        <span
                                                            class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700"
                                                        >
                                                            Visualizado
                                                        </span>
                                                    </div>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        Instalação de
                                                        ar-condicionado 12.000
                                                        BTUs
                                                    </p>
                                                </div>

                                                <div
                                                    class="flex items-center justify-between gap-6 sm:text-right"
                                                >
                                                    <div>
                                                        <p
                                                            class="font-bold text-text"
                                                        >
                                                            R$ 1.250
                                                        </p>
                                                        <p
                                                            class="mt-1 text-xs text-muted"
                                                        >
                                                            há 12 minutos
                                                        </p>
                                                    </div>

                                                    <span
                                                        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted"
                                                        aria-hidden="true"
                                                    >
                                                        →
                                                    </span>
                                                </div>
                                            </div>
                                        </article>

                                        <!-- Marcos -->
                                        <article
                                            class="relative overflow-hidden rounded-2xl border border-brand bg-[rgba(11,59,60,0.025)] p-4 sm:p-5"
                                        >
                                            <div
                                                class="absolute inset-y-0 left-0 w-1 bg-brand"
                                                aria-hidden="true"
                                            >
                                            </div>

                                            <div
                                                class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between"
                                            >
                                                <div class="min-w-0">
                                                    <div
                                                        class="flex flex-wrap items-center gap-2"
                                                    >
                                                        <h4
                                                            class="font-bold text-text"
                                                        >
                                                            Marcos Almeida
                                                        </h4>

                                                        <span
                                                            class="rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700"
                                                        >
                                                            Aguardando resposta
                                                        </span>
                                                    </div>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        Manutenção preventiva
                                                    </p>

                                                    <div
                                                        class="mt-3 inline-flex items-center gap-2 rounded-xl bg-white px-3 py-2 text-sm text-text shadow-sm"
                                                    >
                                                        <span
                                                            class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-50 text-xs font-bold text-amber-700"
                                                        >
                                                            !
                                                        </span>

                                                        Visualizou há 2 dias e
                                                        ainda não respondeu.
                                                    </div>
                                                </div>

                                                <div
                                                    class="flex items-center justify-between gap-4 sm:flex-col sm:items-end"
                                                >
                                                    <div class="sm:text-right">
                                                        <p
                                                            class="font-bold text-text"
                                                        >
                                                            R$ 480
                                                        </p>
                                                        <p
                                                            class="mt-1 text-xs text-muted"
                                                        >
                                                            follow-up
                                                            recomendado
                                                        </p>
                                                    </div>

                                                    <button
                                                        id="open-marcos-quote"
                                                        type="button"
                                                        class="rounded-full bg-brand px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                                    >
                                                        Ver orçamento
                                                    </button>
                                                </div>
                                            </div>
                                        </article>

                                        <!-- Fernanda -->
                                        <article
                                            class="rounded-2xl border border-border bg-white p-4 sm:p-5"
                                        >
                                            <div
                                                class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
                                            >
                                                <div class="min-w-0">
                                                    <div
                                                        class="flex flex-wrap items-center gap-2"
                                                    >
                                                        <h4
                                                            class="font-bold text-text"
                                                        >
                                                            Fernanda Souza
                                                        </h4>

                                                        <span
                                                            class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"
                                                        >
                                                            Aceito
                                                        </span>
                                                    </div>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        Higienização de split
                                                    </p>
                                                </div>

                                                <div
                                                    class="flex items-center justify-between gap-6 sm:text-right"
                                                >
                                                    <div>
                                                        <p
                                                            class="font-bold text-text"
                                                        >
                                                            R$ 350
                                                        </p>
                                                        <p
                                                            class="mt-1 text-xs text-muted"
                                                        >
                                                            serviço fechado
                                                        </p>
                                                    </div>

                                                    <span
                                                        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted"
                                                        aria-hidden="true"
                                                    >
                                                        ✓
                                                    </span>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                </div>

                                <!-- Next step -->
                                <div
                                    class="mt-8 rounded-2xl border border-border bg-surface p-5 sm:flex sm:items-center sm:justify-between sm:gap-8"
                                >
                                    <div>
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            Próxima etapa
                                        </p>

                                        <h3
                                            class="mt-1 text-lg font-bold text-text"
                                        >
                                            Veja o que aconteceu com o orçamento
                                            do Marcos.
                                        </h3>

                                        <p
                                            class="mt-2 max-w-2xl text-sm leading-6 text-muted"
                                        >
                                            Na próxima etapa, vamos abrir esse
                                            orçamento e visualizar toda a linha
                                            do tempo desde o envio.
                                        </p>
                                    </div>

                                    <button
                                        type="button"
                                        disabled
                                        class="mt-5 w-full cursor-not-allowed rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white opacity-50 sm:mt-0 sm:w-auto"
                                    >
                                        Continuar em breve →
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="demo-step-2" class="hidden">
                        <div
                            class="overflow-hidden rounded-3xl border border-border bg-white shadow-[0_24px_80px_rgba(23,35,34,0.08)]"
                        >
                            <!-- Topbar -->
                            <div
                                class="flex flex-col gap-4 border-b border-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7"
                            >
                                <div class="flex items-center gap-3">
                                    <button
                                        id="back-to-dashboard"
                                        type="button"
                                        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition hover:border-brand hover:text-brand"
                                        aria-label="Voltar para o dashboard"
                                    >
                                        ←
                                    </button>

                                    <div>
                                        <p
                                            class="text-sm font-medium text-muted"
                                        >
                                            Orçamento #0028
                                        </p>
                                        <h2
                                            class="mt-1 text-xl font-bold text-text"
                                        >
                                            Marcos Almeida
                                        </h2>
                                    </div>
                                </div>

                                <span
                                    class="w-fit rounded-full bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700"
                                >
                                    Aguardando resposta
                                </span>
                            </div>

                            <div
                                class="grid gap-8 p-5 sm:p-7 lg:grid-cols-[1.15fr_0.85fr]"
                            >
                                <!-- Left -->
                                <div>
                                    <div
                                        class="rounded-2xl border border-border bg-surface p-5"
                                    >
                                        <p
                                            class="text-sm font-medium text-muted"
                                        >
                                            Cliente
                                        </p>

                                        <div
                                            class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
                                        >
                                            <div>
                                                <h3
                                                    class="text-lg font-bold text-text"
                                                >
                                                    Marcos Almeida
                                                </h3>

                                                <p
                                                    class="mt-1 text-sm text-muted"
                                                >
                                                    Manutenção preventiva
                                                </p>
                                            </div>

                                            <div class="sm:text-right">
                                                <p class="text-sm text-muted">
                                                    Valor do orçamento
                                                </p>
                                                <p
                                                    class="mt-1 text-2xl font-bold text-text"
                                                >
                                                    R$ 480
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Timeline -->
                                    <div class="mt-8">
                                        <div>
                                            <p
                                                class="text-sm font-semibold text-brand"
                                            >
                                                Linha do tempo
                                            </p>

                                            <h3
                                                class="mt-1 text-xl font-bold text-text"
                                            >
                                                Veja o que aconteceu depois do
                                                envio.
                                            </h3>
                                        </div>

                                        <div class="mt-6 space-y-0">
                                            <!-- Criado -->
                                            <div
                                                class="grid grid-cols-[40px_1fr] gap-3"
                                            >
                                                <div
                                                    class="flex flex-col items-center"
                                                >
                                                    <div
                                                        class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-sm font-bold text-emerald-700"
                                                    >
                                                        ✓
                                                    </div>

                                                    <div
                                                        class="min-h-10 w-px flex-1 bg-border"
                                                    >
                                                    </div>
                                                </div>

                                                <div class="pb-7 pt-1">
                                                    <p
                                                        class="font-semibold text-text"
                                                    >
                                                        Orçamento criado
                                                    </p>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        04 set • 10:14
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Enviado -->
                                            <div
                                                class="grid grid-cols-[40px_1fr] gap-3"
                                            >
                                                <div
                                                    class="flex flex-col items-center"
                                                >
                                                    <div
                                                        class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-sm font-bold text-emerald-700"
                                                    >
                                                        ✓
                                                    </div>

                                                    <div
                                                        class="min-h-10 w-px flex-1 bg-border"
                                                    >
                                                    </div>
                                                </div>

                                                <div class="pb-7 pt-1">
                                                    <p
                                                        class="font-semibold text-text"
                                                    >
                                                        Enviado pelo WhatsApp
                                                    </p>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        04 set • 10:17
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Visualizado -->
                                            <div
                                                class="grid grid-cols-[40px_1fr] gap-3"
                                            >
                                                <div
                                                    class="flex flex-col items-center"
                                                >
                                                    <div
                                                        class="flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-sm font-bold text-emerald-700"
                                                    >
                                                        ✓
                                                    </div>

                                                    <div
                                                        class="min-h-10 w-px flex-1 bg-border"
                                                    >
                                                    </div>
                                                </div>

                                                <div class="pb-7 pt-1">
                                                    <p
                                                        class="font-semibold text-text"
                                                    >
                                                        Visualizado pelo cliente
                                                    </p>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        04 set • 11:03
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Aguardando -->
                                            <div
                                                class="grid grid-cols-[40px_1fr] gap-3"
                                            >
                                                <div
                                                    class="flex flex-col items-center"
                                                >
                                                    <div
                                                        class="flex h-9 w-9 items-center justify-center rounded-full bg-amber-50 text-sm font-bold text-amber-700"
                                                    >
                                                        !
                                                    </div>
                                                </div>

                                                <div class="pt-1">
                                                    <p
                                                        class="font-semibold text-text"
                                                    >
                                                        Aguardando resposta
                                                    </p>

                                                    <p
                                                        class="mt-1 text-sm text-muted"
                                                    >
                                                        há 2 dias
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right -->
                                <aside>
                                    <div
                                        class="rounded-2xl border border-amber-200 bg-amber-50/60 p-5"
                                    >
                                        <div
                                            class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-sm font-bold text-amber-700 shadow-sm"
                                        >
                                            !
                                        </div>

                                        <p
                                            class="mt-5 text-sm font-semibold text-amber-700"
                                        >
                                            Atenção
                                        </p>

                                        <h3
                                            class="mt-1 text-xl font-bold text-text"
                                        >
                                            Este cliente visualizou, mas ainda
                                            não respondeu.
                                        </h3>

                                        <p
                                            class="mt-3 text-sm leading-6 text-muted"
                                        >
                                            O orçamento foi visualizado há 2
                                            dias. Este pode ser um bom momento
                                            para fazer follow-up antes que a
                                            oportunidade esfrie.
                                        </p>
                                    </div>

                                    <div
                                        class="mt-4 rounded-2xl border border-border bg-white p-5"
                                    >
                                        <p
                                            class="text-sm font-semibold text-brand"
                                        >
                                            Próxima ação sugerida
                                        </p>

                                        <h3
                                            class="mt-1 text-lg font-bold text-text"
                                        >
                                            Preparar uma mensagem de follow-up
                                        </h3>

                                        <p
                                            class="mt-2 text-sm leading-6 text-muted"
                                        >
                                            Na próxima etapa, o Orcento vai
                                            sugerir uma mensagem curta para você
                                            retomar a conversa pelo WhatsApp.
                                        </p>

                                        <button
                                            id="prepare-followup"
                                            type="button"
                                            class="mt-5 w-full rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
                                        >
                                            Preparar follow-up →
                                        </button>
                                    </div>
                                </aside>
                            </div>
                        </div>
                    </div>

                    <div id="demo-step-3" class="hidden">
                        <div
                            class="overflow-hidden rounded-3xl border border-border bg-white shadow-[0_24px_80px_rgba(23,35,34,0.08)]"
                        >
                            <!-- Topbar -->
                            <div
                                class="flex flex-col gap-4 border-b border-border px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-7"
                            >
                                <div class="flex items-center gap-3">
                                    <button
                                        id="back-to-quote"
                                        type="button"
                                        class="flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition hover:border-brand hover:text-brand"
                                        aria-label="Voltar para o orçamento"
                                    >
                                        ←
                                    </button>

                                    <div>
