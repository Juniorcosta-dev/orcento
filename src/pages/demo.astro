        <script>
            const step1 = document.querySelector("#demo-step-1");
            const step2 = document.querySelector("#demo-step-2");
            const step3 = document.querySelector("#demo-step-3");
            const step4 = document.querySelector("#demo-step-4");

            const openQuoteButton =
                document.querySelector("#open-marcos-quote");
            const backButton = document.querySelector("#back-to-dashboard");
            const prepareFollowupButton =
                document.querySelector("#prepare-followup");

            const backToQuoteButton = document.querySelector("#back-to-quote");

            const copyFollowupButton = document.querySelector("#copy-followup");

            const simulateWhatsappButton =
                document.querySelector("#simulate-whatsapp");

            const followupSuccess = document.querySelector("#followup-success");

            const seeDemoResultButton =
                document.querySelector("#see-demo-result");

            const backToFollowupButton =
                document.querySelector("#back-to-followup");

            const demoFinalCta = document.querySelector("#demo-final-cta");

            const stepLabel = document.querySelector("#demo-step-label");

            function trackDemoEvent(eventName: string) {
                const gtag = (
                    window as Window & {
                        gtag?: (
                            command: string,
                            eventName: string,
                            params?: Record<string, unknown>,
                        ) => void;
                    }
                ).gtag;

                if (typeof gtag === "function") {
                    gtag("event", eventName);
                }

                console.log("[analytics]", eventName);
            }

            function showStep(step: HTMLElement | null) {
                [step1, step2, step3, step4].forEach((item) => {
                    if (item instanceof HTMLElement) {
                        item.classList.add("hidden");
                    }
                });

                if (step instanceof HTMLElement) {
                    step.classList.remove("hidden");

                    step.scrollIntoView({
                        behavior: "smooth",
                        block: "start",
                    });
                }
            }

            openQuoteButton?.addEventListener("click", () => {
                trackDemoEvent("demo_quote_opened");

                showStep(step2 instanceof HTMLElement ? step2 : null);

                if (stepLabel) {
                    stepLabel.textContent = "Etapa 2 de 4";
                }
            });

            backButton?.addEventListener("click", () => {
                showStep(step1 instanceof HTMLElement ? step1 : null);

                if (stepLabel) {
                    stepLabel.textContent = "Etapa 1 de 4";
                }
            });

            prepareFollowupButton?.addEventListener("click", () => {
                trackDemoEvent("demo_followup_started");

                showStep(step3 instanceof HTMLElement ? step3 : null);

                if (stepLabel) {
                    stepLabel.textContent = "Etapa 3 de 4";
                }
            });

            backToQuoteButton?.addEventListener("click", () => {
                showStep(step2 instanceof HTMLElement ? step2 : null);

                if (stepLabel) {
                    stepLabel.textContent = "Etapa 2 de 4";
                }
            });

            copyFollowupButton?.addEventListener("click", async () => {
                const message =
                    "Olá, Marcos! Tudo bem?\n\nPassando para saber se ficou alguma dúvida sobre o orçamento da manutenção preventiva.\n\nSe precisar, posso te explicar os detalhes.";

                try {
                    await navigator.clipboard.writeText(message);

                    if (copyFollowupButton instanceof HTMLButtonElement) {
                        copyFollowupButton.textContent = "Mensagem copiada ✓";
                    }
                } catch (error) {
                    console.error("Não foi possível copiar a mensagem:", error);
                }
            });

            simulateWhatsappButton?.addEventListener("click", () => {
                trackDemoEvent("demo_followup_simulated");

                if (followupSuccess instanceof HTMLElement) {
                    followupSuccess.classList.remove("hidden");
                }

                if (simulateWhatsappButton instanceof HTMLButtonElement) {
                    simulateWhatsappButton.disabled = true;
                    simulateWhatsappButton.textContent = "Mensagem enviada ✓";

                    simulateWhatsappButton.classList.add(
                        "cursor-not-allowed",
                        "opacity-60",
                    );
                }

                if (seeDemoResultButton instanceof HTMLButtonElement) {
                    seeDemoResultButton.disabled = false;

                    seeDemoResultButton.classList.remove(
                        "cursor-not-allowed",
                        "opacity-50",
                    );
                }
            });

            seeDemoResultButton?.addEventListener("click", () => {
                trackDemoEvent("demo_completed");

                showStep(step4 instanceof HTMLElement ? step4 : null);

                if (stepLabel) {
                    stepLabel.textContent = "Etapa 4 de 4";
                }
            });

            backToFollowupButton?.addEventListener("click", () => {
                showStep(step3 instanceof HTMLElement ? step3 : null);

                if (stepLabel) {
                    stepLabel.textContent = "Etapa 3 de 4";
                }
            });

            demoFinalCta?.addEventListener("click", () => {
                trackDemoEvent("demo_cta_clicked");
            });
        </script>
