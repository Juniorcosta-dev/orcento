---
import "../styles/global.css";
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>Você está na lista | Orcento</title>

        <meta
            name="description"
            content="Obrigado por participar da validação e entrar para a lista de acesso antecipado."
        />

        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="robots" content="noindex" />

        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-72B6FEKD9G"
        ></script>

        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                window.dataLayer.push(arguments);
            }

            gtag("js", new Date());
            gtag("config", "G-72B6FEKD9G");
        </script>
    </head>

    <body>
        <main class="min-h-screen bg-surface
      px-5 py-12 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-3xl">
                <a
                    href="/"
                    class="inline-flex items-center gap-2
          font-bold tracking-tight text-brand"
                >
                    <span
                        class="flex size-9 items-center justify-center
            rounded-xl bg-brand
            text-sm text-white"
                    >
                        O
                    </span>

                    <span class="text-lg">Orcento</span>
                </a>

                <div
                    class="mt-12 rounded-[28px]
          border border-border
          bg-white p-6
          shadow-[0_30px_80px_rgba(11,59,60,0.10)]
          sm:p-9"
                >
                    <div
                        class="flex size-12 items-center justify-center
            rounded-full bg-[#e9f8f1]
            text-xl font-bold text-accent"
                    >
                        ✓
                    </div>

                    <p
                        class="mt-6 text-sm font-semibold uppercase
            tracking-[0.16em] text-accent"
                    >
                        Cadastro recebido
                    </p>

                    <h1
                        class="mt-3 text-3xl font-bold tracking-[-0.03em]
            text-text sm:text-4xl"
                    >
                        Você entrou para a lista de acesso antecipado.
                    </h1>

                    <p
                        class="mt-5 max-w-2xl text-lg leading-8
            text-muted"
                    >
                        Estamos conversando com os primeiros profissionais antes
                        de desenvolver a versão inicial do produto.
                    </p>

                    <div
                        class="mt-9 rounded-2xl
            bg-surface p-5 sm:p-6"
                    >
                        <p
                            class="text-sm font-semibold
              text-brand"
                        >
                            Uma última pergunta
                        </p>

                        <h2
                            class="mt-2 text-xl font-bold tracking-tight
              text-text sm:text-2xl"
                        >
                            Se isso realmente ajudasse você a acompanhar seus
                            orçamentos, consideraria pagar R$ 19,90 por mês?
                        </h2>

                        <p class="mt-3 leading-7 text-muted">
                            Essa resposta nos ajuda a entender se o problema tem
                            valor suficiente para justificar um produto pago.
                        </p>

                        <div
                            class="mt-6 grid gap-3 sm:grid-cols-3"
                            id="price-options"
                        >
                            <button
                                type="button"
                                data-price-answer="yes"
                                class="rounded-xl bg-brand
                px-5 py-3 font-semibold text-white
                transition hover:bg-brand-dark"
                            >
                                Sim
                            </button>

                            <button
                                type="button"
                                data-price-answer="maybe"
                                class="rounded-xl border
                border-border
                bg-white px-5 py-3 font-semibold
                text-text transition
                hover:border-brand"
                            >
                                Talvez
                            </button>

                            <button
                                type="button"
                                data-price-answer="no"
                                class="rounded-xl border
                border-border
                bg-white px-5 py-3 font-semibold
                text-muted transition
                hover:border-brand"
                            >
                                Não
                            </button>
                        </div>

                        <div
                            id="price-feedback"
                            class="mt-4 hidden rounded-xl
              border border-border
              bg-white px-4 py-3 text-sm
              text-muted"
                        >
                            Obrigado pela resposta.
                        </div>
                    </div>

                    <div
                        class="mt-7 rounded-2xl
            border border-border
            p-5"
                    >
                        <h2 class="font-bold text-text">
                            Quer conversar sobre como você faz seus orçamentos
                            hoje?
                        </h2>

                        <p
                            class="mt-2 text-sm leading-6
              text-muted"
                        >
                            Falar diretamente conosco é um dos sinais mais
                            importantes para entender se vale a pena construir o
                            produto.
                        </p>

                        <a
                            href="https://wa.me/5528999258540?text=Olá%21%20Me%20cadastrei%20para%20testar%20a%20Orcento%20e%20gostaria%20de%20conversar."
                            id="whatsapp-contact"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="mt-5 inline-flex w-full
                            items-center justify-center rounded-xl
                            bg-accent px-6 py-3
                            font-semibold text-white transition
                            hover:opacity-90 sm:w-auto"
                        >
                            Falar comigo pelo WhatsApp
                            <span class="ml-2" aria-hidden="true">→</span>
                        </a>
                    </div>

                    <p class="mt-7 text-center text-sm
            text-muted">
                        Obrigado por ajudar a construir algo baseado em um
                        problema real.
                    </p>
                </div>
            </div>
        </main>

        <script>
            function sendAnalyticsEvent(eventName: string) {
                const gtag = (
                    window as Window & {
                        gtag?: (
                            command: string,
                            eventName: string,
                            params?: Record<string, unknown>,
                        ) => void;
                    }
                ).gtag;

                if (typeof gtag === "function") {
                    gtag("event", eventName);
                }

                console.log("[analytics]", eventName);
            }

            const priceButtons = document.querySelectorAll(
                "[data-price-answer]",
            );
            const feedback = document.querySelector("#price-feedback");

            const priceEvents: Record<string, string> = {
                yes: "price_yes",
                maybe: "price_maybe",
                no: "price_no",
            };

            let priceAnswered = false;

            priceButtons.forEach((button) => {
                button.addEventListener("click", () => {
                    if (priceAnswered) return;

                    priceAnswered = true;

                    const answer = button.getAttribute("data-price-answer");

                    if (answer) {
                        const eventName = priceEvents[answer];

                        if (eventName) {
                            sendAnalyticsEvent(eventName);
                        }
                    }

                    priceButtons.forEach((item) => {
                        item.setAttribute("aria-pressed", "false");
                    });

                    priceButtons.forEach((item) => {
                        if (item instanceof HTMLButtonElement) {
                            item.disabled = true;
                            item.classList.add(
                                "opacity-60",
                                "cursor-not-allowed",
                            );
                        }
                    });

                    button.setAttribute("aria-pressed", "true");

                    if (feedback) {
                        feedback.classList.remove("hidden");
                    }
                });
            });

            const whatsappButton = document.querySelector("#whatsapp-contact");

            whatsappButton?.addEventListener("click", () => {
                sendAnalyticsEvent("whatsapp_clicked");
            });
        </script>
    </body>
</html>
